# Wedding 101 — environment variables
#
# LOCAL DEV: you don't need any of these. With none set, the app runs fully local
# (data in your browser). Just `npm run dev`.
#
# PRODUCTION (Vercel): set these three in the Vercel project → Settings → Environment
# Variables, then deploy. Cloud mode turns on automatically once the /api backend is
# live — there's no frontend flag to set. See DEPLOY.md for the full walkthrough.

# Your Neon Postgres connection string (Neon dashboard → Connection Details).
# Use the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# The single passcode you share with your family to open the dashboard.
FAMILY_PASSCODE=change-me-to-something-only-family-knows

# A long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
